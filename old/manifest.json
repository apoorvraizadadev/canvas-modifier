{
    "manifest_version": 3,
    "name": "Canvas Modifier",
    "version": "0.3.0",
    "description": "Modifies Canvas",
    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": ["https://*.instructure.com/*"],
            "css": ["user_defined.css"],
            "js": ["content.js", "config_loader.js"]
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["fonts/*.ttf", "config.csv"],
            "matches": ["<all_urls>"]
        }
    ],

    "permissions": [
        "activeTab",
        "storage" 
    ]
}